---
import Layout from "../../layouts/Layout.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout title="Professional Resume">
  <div class="w-4/5  flex justify-center items-center font-serif">
    <div class="flex gap-4 flex-row">
      <!-- Left Column (60%) -->
      <div class="w-[60%] flex flex-col">
        <!-- Profile Section -->
        <div class="flex items-center mb-6">
          <img
            src="../../public/images/profile.webp"
            alt="Luis Fernando Lainez Meza"
            class="w-20 h-20 rounded-full mr-4"
          />
          <h1 class="text-2xl font-bold text-gray-800">
            Luis Fernando Laínez Meza
          </h1>
        </div>

        <!-- About Me Section -->
        <div class="mb-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-2">Profile</h2>
          <p class="text-gray-600">
            I am a full-stack web and mobile application developer with almost 8
            years of professional experience. Thanks to the experience I have
            gained, I have learned to adapt to changing environments, the
            importance of teamwork, self-taught learning, and always staying
            updated with new technologies. Personally, I am very passionate
            about programming, always looking to improve my skills and enrich
            my knowledge.
          </p>
        </div>

        <!-- Employment History Section -->
        <div>
          <h2 class="text-xl font-semibold text-gray-800 mb-4">
            Work Experience
          </h2>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-gray-800">
              Full Stack, WGSN, New York
            </h3>
            <p class="text-sm text-gray-400 mb-2">JUNE 2024 - PRESENT</p>
            <p class="text-gray-600">
              I participate in the WGSN development team responsible for
              creating, optimizing, and improving key internal services for the
              company's operations.
            </p>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-gray-800">
              Tech Lead, Code Exitos, Tegucigalpa
            </h3>
            <p class="text-sm text-gray-400 mb-2">OCTOBER 2023 - JUNE 2024</p>
            <p class="text-gray-600">
              As a tech lead, I have led a project with a team of 6 members,
              including developers and designers. The project uses AI
              technology, for which we trained our own model using Vertex AI on
              GCP. Additionally, we use Text-to-Speech (TTS) and
              Speech-to-Text (STT) services to facilitate natural interaction.
            </p>
            <p class="text-gray-600 pt-4">
              I collaborated on the development team for the application used
              by Stellantis dealerships in Canada, optimizing the quoting,
              sales, and car demonstration processes.
            </p>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-gray-800">
              Senior Full Stack Developer, Code Exitos, Tegucigalpa
            </h3>
            <p class="text-sm text-gray-400 mb-2">JULY 2022 - OCTOBER 2023</p>
            <p class="text-gray-600">
              I have had the opportunity to develop highly complex projects
              both at an architectural and logical level, including the
              development and implementation of microservices, web 3.0.
              Projects I worked on: Stellantis, Binbox Smart Locker, etc...
            </p>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-gray-800">
              Senior Developer, Team Lead, Farinter, Tegucigalpa
            </h3>
            <p class="text-sm text-gray-400 mb-2">
              DECEMBER 2019 - JULY 2022
            </p>
            <p class="text-gray-600">
              At Farinter, I had a greater focus on E-commerce development,
              participating in both front-end and back-end development. In
              addition to significant professional growth, I had the
              opportunity to lead a development team.
            </p>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-gray-800">
              Web Developer, AUREM
            </h3>
            <p class="text-sm text-gray-400 mb-2">
              FEBRUARY 2018 - DECEMBER 2019
            </p>
            <p class="text-gray-600">
              During this period, I worked under the agile SCRUM methodology
              using React.js, Meteor.js, Express.js, and MongoDB as the main
              frameworks to carry out different projects. My time at AUREM gave
              me great experience in developing APIs, CMS, and CRM.
            </p>
          </div>
          <!-- Education Section -->
          <div>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">Education</h2>

            <div class="mb-4">
              <h3 class="text-lg font-medium text-gray-800">
                Computer Systems Engineer, UNITEC
              </h3>
              <p class="text-sm text-gray-400 mb-2">JANUARY 2015 - JUNE 2021</p>
            </div>

            <div class="mb-4">
              <h3 class="text-lg font-medium text-gray-800">
                Course on Intelligent Systems and Emerging Technologies,
                Polytechnic University of Valencia, Valencia
              </h3>
              <p class="text-sm text-gray-400 mb-2">JULY 2019 - AUGUST 2019</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column (40%) -->
      <div class="w-[40%] bg-gray-800 p-6 rounded-lg">
        <!-- Content for the right column will go here -->
        <!-- Details Section -->
        <div class="mb-6">
          <h2 class="text-xl font-semibold text-white mb-4">Details</h2>
          <div class="mb-4">
            <p class="text-gray-300">Tegucigalpa, Honduras</p>
            <p class="text-gray-300">+504 9780-5284</p>
            <p class="text-gray-300">llainez.meza@gmail.com</p>
          </div>

          <h2 class="text-xl font-semibold text-white mb-4">Links</h2>
          <div class="mb-4">
            <p class="text-gray-300">
              <a
                href="https://www.linkedin.com/in/luis-lainez-5ab85417b/"
                class="text-blue-400 hover:text-blue-300">LinkedIn</a
              >
            </p>
          </div>
        </div>

        <!-- Skills Section -->
        <div class="bg-gray-700 p-6 rounded-lg shadow-sm mb-6">
          <h2 class="text-xl font-semibold text-white mb-4">Skills</h2>
          <ul class="list-disc pl-5 mb-4">
            <li class="text-gray-300 mb-1">
              Ability to work under pressure
            </li>
            <li class="text-gray-300 mb-1">Problem-solving</li>
            <li class="text-gray-300 mb-1">Teamwork</li>
            <li class="text-gray-300 mb-1">Leadership</li>
            <li class="text-gray-300 mb-1">Communication</li>
            <li class="text-gray-300 mb-1">Multitasking</li>
            <li class="text-gray-300 mb-1">Adaptability</li>
            <li class="text-gray-300 mb-1">Good time management</li>
          </ul>
        </div>

        <!-- Languages Section -->
        <div class="bg-gray-700 p-6 rounded-lg shadow-sm mb-6">
          <h2 class="text-xl font-semibold text-white mb-4">Languages</h2>
          <ul class="list-disc pl-5 mb-4">
            <li class="text-gray-300 mb-1">Spanish</li>
            <li class="text-gray-300 mb-1">English</li>
          </ul>
        </div>

        <!-- Technologies Section -->
        <div class="bg-gray-700 p-6 rounded-lg shadow-sm mb-6">
          <h2 class="text-xl font-semibold text-white mb-4">Technologies</h2>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-white mb-2">Front-end</h3>
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >React.js</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm">Vue.js</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >Next.js</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >Angular</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >React Native</span
              >
            </div>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-white mb-2">Back-end</h3>
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >Express.js</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >Nest.js</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >Node.js</span
              >
            </div>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-white mb-2">Database</h3>
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >PostgreSQL</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm">SQL</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >MongoDB</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >DynamoDB</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm">Redis</span>
            </div>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-white mb-2">Services</h3>
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-300 px-2 py-1 rounded text-sm">AWS</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">GCP</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">Azure</span>
            </div>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-white mb-2">
              Programming Languages
            </h3>
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >JavaScript</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm"
                >TypeScript</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm">Python</span
              >
              <span class="text-gray-300 px-2 py-1 rounded text-sm">C++</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">Java</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
</Layout>
