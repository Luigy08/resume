---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils.ts";
// Determine language & translation function
const lang = getLangFromUrl(new URL(Astro.request.url));
const t = useTranslations(lang);
---

<Layout title="Professional Resume">
  <div class="w-4/5 flex justify-center items-center font-serif">
    <div class="flex gap-4 flex-row">
      <!-- Left Column (60%) -->
      <div class="w-[60%] flex flex-col">
        <!-- Profile Section -->
        <div class="flex items-center mb-6">
          <img
            src="../../public/images/profile.webp"
            alt={t('profile.name')}
            class="w-30 h-30 rounded-full object-cover mr-4"
          />
          <h1 class="text-2xl font-bold text-gray-800">
            {t('profile.name')}
          </h1>
        </div>

        <!-- About Me Section -->
        <div class="mb-6">
          <h2 class="text-xl font-semibold text-gray-800 mb-2">
            {t("about.title")}
          </h2>
          <p class="text-gray-600">
            {t("about.text")}
          </p>
          <p class="text-gray-600 mt-4">
            {t("about.ai")}
          </p>
        </div>

        <!-- Employment History Section -->
        <div>
          <h2 class="text-xl font-semibold text-gray-800 mb-4">
            {t('section.experience')}
          </h2>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-gray-800">
              {t('experience.wgsn.title')}
            </h3>
            <p class="text-sm text-gray-400 mb-2">{t('experience.wgsn.dates')}</p>
            <p class="text-gray-600">
              {t('experience.wgsn.description')}
            </p>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-gray-800">
              {t('experience.techlead.title')}
            </h3>
            <p class="text-sm text-gray-400 mb-2">{t('experience.techlead.dates')}</p>
            <p class="text-gray-600">
              {t('experience.techlead.description1')}
            </p>
            <p class="text-gray-600 pt-4">
              {t('experience.techlead.description2')}
            </p>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-gray-800">
              {t('experience.fullstack.title')}
            </h3>
            <p class="text-sm text-gray-400 mb-2">{t('experience.fullstack.dates')}</p>
            <p class="text-gray-600">
              {t('experience.fullstack.description')}
            </p>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-gray-800">
              {t('experience.farinter.title')}
            </h3>
            <p class="text-sm text-gray-400 mb-2">{t('experience.farinter.dates')}</p>
            <p class="text-gray-600">{t("experience.farinter.description")}</p>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-gray-800">
              {t('experience.webdev.title')}
            </h3>
            <p class="text-sm text-gray-400 mb-2">
              {t('experience.webdev.dates')}
            </p>
            <p class="text-gray-600">
              {t('experience.webdev.description')}
            </p>
          </div>
          <!-- Education Section -->
          <div>
            <h2 class="text-xl font-semibold text-gray-800 mb-4">{t('section.education')}</h2>

            <div class="mb-4">
              <h3 class="text-gray-800">
                {t('education.degree')}
              </h3>
              <p class="text-sm text-gray-400 mb-2">{t('education.degree.dates')}</p>
            </div>

            <div class="mb-4">
              <h3 class="text-gray-800">
                {t('education.course')}
              </h3>
              <p class="text-sm text-gray-400 mb-2">{t('education.course.dates')}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column (40%) -->
      <div class="w-[40%] bg-gray-800 p-6 rounded-lg">
        <!-- Details Section -->
        <div class="mb-6">
          <h2 class="text-xl font-semibold text-white mb-4">{t('section.details')}</h2>
          <div class="mb-4">
            <p class="text-gray-300">{t('details.location')}</p>
            <p class="text-gray-300">{t('details.phone')}</p>
            <p class="text-gray-300">{t('details.email')}</p>
          </div>

          <h2 class="text-xl font-semibold text-white mb-4">{t('section.links')}</h2>
          <div class="mb-4">
            <p class="text-gray-300">
              <a
                href="https://www.linkedin.com/in/luis-lainez-5ab85417b/"
                class="text-blue-400 hover:text-blue-300">{t('link.linkedin')}</a
              >
            </p>
          </div>
        </div>

        <!-- Skills Section -->
        <div class="bg-gray-700 p-6 rounded-lg shadow-sm mb-6">
          <h2 class="text-xl font-semibold text-white mb-4">{t('section.skills')}</h2>
          <ul class="list-disc pl-5 mb-4">
            <li class="text-gray-300 mb-1">{t('skill.pressure')}</li>
            <li class="text-gray-300 mb-1">{t('skill.problemSolving')}</li>
            <li class="text-gray-300 mb-1">{t('skill.teamwork')}</li>
            <li class="text-gray-300 mb-1">{t('skill.leadership')}</li>
            <li class="text-gray-300 mb-1">{t('skill.communication')}</li>
            <li class="text-gray-300 mb-1">{t('skill.multitasking')}</li>
            <li class="text-gray-300 mb-1">{t('skill.adaptability')}</li>
            <li class="text-gray-300 mb-1">{t('skill.timeManagement')}</li>
          </ul>
        </div>

        <!-- Languages Section -->
        <div class="bg-gray-700 p-6 rounded-lg shadow-sm mb-6">
          <h2 class="text-xl font-semibold text-white mb-4">{t('section.languages')}</h2>
          <ul class="list-disc pl-5 mb-4">
            <li class="text-gray-300 mb-1">{t('language.spanish')}</li>
            <li class="text-gray-300 mb-1">{t('language.english')}</li>
          </ul>
        </div>

        <!-- Technologies Section -->
        <div class="bg-gray-700 p-6 rounded-lg shadow-sm mb-6">
          <h2 class="text-xl font-semibold text-white mb-4">{t('section.technologies')}</h2>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-white mb-2">{t('tech.frontend')}</h3>
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.react')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.vue')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.next')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.angular')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.reactnative')}</span>
            </div>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-white mb-2">{t('tech.backend')}</h3>
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.express')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.nest')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.node')}</span>
            </div>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-white mb-2">{t('tech.database')}</h3>
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.postgresql')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.sql')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.mongodb')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.dynamodb')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.redis')}</span>
            </div>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-white mb-2">{t('tech.services')}</h3>
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.aws')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.gcp')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.azure')}</span>
            </div>
          </div>

          <div class="mb-4">
            <h3 class="text-lg font-medium text-white mb-2">{t('tech.languages')}</h3>
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.javascript')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.typescript')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.python')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.cpp')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.java')}</span>
            </div>
          </div>

          <!-- AI & Dev Tools Section -->
          <div class="mb-4">
            <h3 class="text-lg font-medium text-white mb-2">{t('tech.ai_tools')}</h3>
            <div class="flex flex-wrap gap-2">
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.cursor')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.antigravity')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.vertex')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.openai')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.mcp')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.skills')}</span>
              <span class="text-gray-300 px-2 py-1 rounded text-sm">{t('tech.llms')}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
